# Optional: point pip at an internal PyPI mirror instead of the public
# index, e.g. for corporate networks that block direct PyPI access.
#
# Copy or merge into your pip config, e.g.:
#   macOS/Linux: ~/.config/pip/pip.conf   (or ~/.pip/pip.conf)
# Or point pip at this file once:
#   export PIP_CONFIG_FILE=/path/to/raas-mcp/pip.conf.example
#
# raas-mcp has no dependency that requires an internal index — this is
# purely a network-access convenience, not a requirement.

[global]
# index-url = https://your-internal-mirror.example.com/simple

# Uncomment if your environment requires explicit host trust:
# trusted-host = your-internal-mirror.example.com
